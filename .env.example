COMPOSE_PROJECT_NAME=qqbot-napcat-astrbot
TZ=Asia/Shanghai

# AstrBot uses a verified release tag. NapCat publishes a rolling image.
ASTRBOT_IMAGE=soulter/astrbot:v4.28.2
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest
ASTRBOT_WEBUI_PORT=6185
NAPCAT_WEBUI_PORT=6099
NAPCAT_UID=1000
NAPCAT_GID=1000

# scripts/init.py generates local credentials; never commit .env.
NAPCAT_WEBUI_TOKEN=CHANGE_ME_NAPCAT_WEBUI_TOKEN
ASTRBOT_DASHBOARD_INITIAL_PASSWORD=CHANGE_ME_ASTRBOT_PASSWORD
ONEBOT_ACCESS_TOKEN=CHANGE_ME_ONEBOT_ACCESS_TOKEN
